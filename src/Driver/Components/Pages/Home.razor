@page "/"
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@using QuillConverter
@using System.Text.Json
@inject ISnackbar snackbar

<PageTitle>Home</PageTitle>
<div style="display:block;">

    @foreach (var item in items)
    {
        @* <MudTextField Placeholder="Title" Value="@("_noteText_" + item.Id)" Class="round-input" /> *@
        <MudTextEditor @bind-Value="item.content" OutputDelta="true" Snackbar="snackbar" Label="@item.Id.ToString()" MaxHTMLLength="55000" UniqueID="@("_noteText_" + item.Id)" Variant="Variant.Outlined" BottomToolbar="false" Style="max-height: 400px;" />
        <br />
    }

</div>
<br />
<div>
    <MudButton OnClick="AddNewItem">button</MudButton>
</div>
